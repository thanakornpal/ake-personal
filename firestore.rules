rules_version = '2';

// Security model (matches UC-01, UC-09, UC-17 in the use-case doc):
// - Every document lives under users/{uid}/... — a user can only ever
//   read or write their own subtree. There is no cross-user query path.
// - Writes are validated server-side too (see api/uploads/presign.ts) —
//   these rules are the last line of defense, not the only one.
// - Attachment *metadata* lives in Firestore; the actual file bytes live
//   in R2 and are never reachable without a short-lived presigned URL
//   minted by the API after it re-checks ownership (UC-09.1 / UC-09.2).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Basic shape check for a new/updated timeline item so a compromised
    // client can't smuggle extra fields or a mismatched ownerId.
    function validTimelineItem(data) {
      return data.ownerId == request.auth.uid
        && data.category is string
        && data.title is string
        && data.title.size() > 0
        && data.occurredAt is string;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /timeline/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validTimelineItem(request.resource.data);
        allow update: if isOwner(uid) && validTimelineItem(request.resource.data);
      }

      match /attachments/{attachmentId} {
        // Attachment metadata only — no raw bytes, no bucket credentials.
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.objectKey is string
          && request.resource.data.objectKey.matches('^users/' + uid + '/.*');
        allow update: if isOwner(uid);
      }

      match /insurance/{docId} { allow read, write: if isOwner(uid); }
      match /warranties/{docId} { allow read, write: if isOwner(uid); }
      match /documents/{docId} { allow read, write: if isOwner(uid); }
      match /certificates/{docId} { allow read, write: if isOwner(uid); }
      match /assets/{docId} { allow read, write: if isOwner(uid); }
      match /auditLog/{logId} {
        // Audit entries are append-only from the client's point of view;
        // real deletes/updates should only ever happen from a trusted
        // server context (Admin SDK bypasses rules).
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
